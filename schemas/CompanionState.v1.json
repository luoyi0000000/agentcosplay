{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "description": "Bound a proposed memory summary; confidence does not establish factual authority.\n\n约束记忆摘要候选；置信度不建立事实权威。",
      "properties": {
        "content": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "kind": {
          "default": "character_long_term",
          "enum": [
            "session",
            "short_term",
            "character_long_term",
            "relationship",
            "real_user"
          ],
          "title": "Kind",
          "type": "string"
        },
        "importance": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Importance",
          "type": "number"
        },
        "confidence": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "default": "conversation",
          "maxLength": 2000,
          "title": "Source",
          "type": "string"
        },
        "ttl_seconds": {
          "anyOf": [
            {
              "maximum": 31536000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttl Seconds"
        }
      },
      "required": [
        "content"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "Persist a reserved intent and delivery state, not evidence that a message was sent.\n\n保存预留意图及投递状态，不证明消息已经发送。",
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "should_contact": {
          "default": false,
          "title": "Should Contact",
          "type": "boolean"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "reserved",
            "generation_requested",
            "delivery_pending",
            "delivered",
            "failed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "claim_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "topic_fingerprint": {
          "default": "",
          "maxLength": 64,
          "title": "Topic Fingerprint",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 240,
          "title": "Reason",
          "type": "string"
        },
        "topic": {
          "default": "",
          "maxLength": 500,
          "title": "Topic",
          "type": "string"
        },
        "topic_id": {
          "default": "",
          "maxLength": 220,
          "title": "Topic Id",
          "type": "string"
        },
        "urgency": {
          "default": "low",
          "enum": [
            "low",
            "normal",
            "high"
          ],
          "title": "Urgency",
          "type": "string"
        },
        "context": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 5,
          "title": "Context",
          "type": "object"
        },
        "silence_reason": {
          "default": "",
          "maxLength": 100,
          "title": "Silence Reason",
          "type": "string"
        },
        "cooldown": {
          "default": 0,
          "minimum": 0,
          "title": "Cooldown",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "title": "Decision",
      "type": "object"
    },
    "Goal": {
      "additionalProperties": false,
      "description": "Track configured intent and progress; a plan is not evidence of a completed event.\n\n记录配置意图及进度；计划不是已完成事件的证据。",
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source": {
          "default": "user_explicit",
          "enum": [
            "user_explicit",
            "definition",
            "schedule",
            "growth",
            "simulated_life"
          ],
          "title": "Source",
          "type": "string"
        },
        "importance": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Importance",
          "type": "number"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "paused",
            "completed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deadline": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        },
        "progress": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Progress",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Evidence Ids",
          "type": "array"
        },
        "activity": {
          "default": "reading",
          "enum": [
            "idle",
            "reading",
            "resting",
            "working",
            "walking",
            "eating"
          ],
          "title": "Activity",
          "type": "string"
        },
        "simulate": {
          "default": false,
          "title": "Simulate",
          "type": "boolean"
        },
        "simulated_hours": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Simulated Hours",
          "type": "number"
        },
        "simulation_milestone": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Simulation Milestone",
          "type": "integer"
        }
      },
      "required": [
        "description"
      ],
      "title": "Goal",
      "type": "object"
    },
    "Habit": {
      "additionalProperties": false,
      "description": "Track gradual habit support separately from immutable character identity.\n\n记录渐进习惯支持，与不可变角色身份分离。",
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "activity": {
          "default": "reading",
          "enum": [
            "idle",
            "reading",
            "resting",
            "working",
            "walking",
            "eating"
          ],
          "title": "Activity",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Evidence Ids",
          "type": "array"
        },
        "observed_days": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Observed Days",
          "type": "array"
        },
        "established": {
          "default": false,
          "title": "Established",
          "type": "boolean"
        },
        "strength": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Strength",
          "type": "number"
        },
        "source": {
          "default": "user_explicit",
          "enum": [
            "user_explicit",
            "simulated_life"
          ],
          "title": "Source",
          "type": "string"
        },
        "last_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Observed At"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "Habit",
      "type": "object"
    },
    "JsonValue": {},
    "LifeState": {
      "additionalProperties": false,
      "description": "Track simulated activity timing; simulation must not become shared experience.\n\n记录模拟活动时序；模拟不能变成用户共同经历。",
      "properties": {
        "activity": {
          "default": "idle",
          "enum": [
            "idle",
            "reading",
            "resting",
            "working",
            "walking",
            "eating"
          ],
          "title": "Activity",
          "type": "string"
        },
        "current_process": {
          "default": "daily_routine",
          "maxLength": 100,
          "title": "Current Process",
          "type": "string"
        },
        "current_phase": {
          "default": "idle",
          "maxLength": 100,
          "title": "Current Phase",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "expected_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected End"
        },
        "next_decision_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Decision After"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "const": "simulated_life",
          "default": "simulated_life",
          "title": "Source",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 240,
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "LifeState",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "Keep observation, fetch and expiry times distinct with bounded freshness.\n\n区分观察、获取及到期时间，限制新鲜度。",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "confidence": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "kind": {
          "enum": [
            "time",
            "weather",
            "schedule",
            "location"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "title": "Summary",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "location_scope": {
          "default": "",
          "maxLength": 100,
          "title": "Location Scope",
          "type": "string"
        },
        "condition": {
          "default": "unknown",
          "enum": [
            "unknown",
            "clear",
            "rain",
            "snow",
            "storm"
          ],
          "title": "Condition",
          "type": "string"
        },
        "activity": {
          "anyOf": [
            {
              "enum": [
                "idle",
                "reading",
                "resting",
                "working",
                "walking",
                "eating"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity"
        },
        "availability": {
          "default": "unknown",
          "enum": [
            "unknown",
            "available",
            "busy",
            "unavailable"
          ],
          "title": "Availability",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "summary",
        "observed_at",
        "fetched_at",
        "expires_at"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Settings": {
      "additionalProperties": false,
      "description": "Keep explicit opt-in controls and proactive quiet/rate limits.\n\n保存显式启用开关，以及主动联系的安静时段和频率限制。",
      "properties": {
        "proactive_contact": {
          "default": false,
          "title": "Proactive Contact",
          "type": "boolean"
        },
        "schedule_awareness": {
          "default": false,
          "title": "Schedule Awareness",
          "type": "boolean"
        },
        "weather_awareness": {
          "default": false,
          "title": "Weather Awareness",
          "type": "boolean"
        },
        "life_simulation": {
          "default": false,
          "title": "Life Simulation",
          "type": "boolean"
        },
        "relationship_growth": {
          "default": true,
          "title": "Relationship Growth",
          "type": "boolean"
        },
        "timezone": {
          "default": "UTC",
          "maxLength": 100,
          "title": "Timezone",
          "type": "string"
        },
        "quiet_start": {
          "default": 22,
          "maximum": 23,
          "minimum": 0,
          "title": "Quiet Start",
          "type": "integer"
        },
        "quiet_end": {
          "default": 8,
          "maximum": 23,
          "minimum": 0,
          "title": "Quiet End",
          "type": "integer"
        },
        "cooldown_seconds": {
          "default": 21600,
          "maximum": 604800,
          "minimum": 3600,
          "title": "Cooldown Seconds",
          "type": "integer"
        },
        "recent_activity_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 300,
          "title": "Recent Activity Seconds",
          "type": "integer"
        },
        "max_contacts_per_day": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Contacts Per Day",
          "type": "integer"
        },
        "availability": {
          "default": "unknown",
          "enum": [
            "unknown",
            "available",
            "busy",
            "unavailable"
          ],
          "title": "Availability",
          "type": "string"
        }
      },
      "title": "Settings",
      "type": "object"
    },
    "Topic": {
      "additionalProperties": false,
      "description": "Keep opted-in follow-up relevance and cooldown state.\n\n保存已允许跟进的话题相关性及冷却状态。",
      "properties": {
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "relevance": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Relevance",
          "type": "number"
        },
        "priority": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Priority",
          "type": "number"
        },
        "cooldown_seconds": {
          "default": 604800,
          "maximum": 31536000,
          "minimum": 86400,
          "title": "Cooldown Seconds",
          "type": "integer"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "resolved",
            "dismissed"
          ],
          "title": "Status",
          "type": "string"
        },
        "last_mentioned_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Mentioned At"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "Topic",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Current life state plus an opaque historical Mood archive.\n\n当前生活状态附带不透明的历史 Mood 档案；未知字段往返保留，不参与当前决策。",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "character_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Character Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "mood": {
      "additionalProperties": {
