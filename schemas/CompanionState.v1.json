      },
      "maxItems": 30,
      "title": "Topics",
      "type": "array"
    },
    "life": {
      "$ref": "#/$defs/LifeState"
    },
    "observations": {
      "additionalProperties": {
        "$ref": "#/$defs/Observation"
      },
      "maxProperties": 4,
      "title": "Observations",
      "type": "object"
    },
    "last_advanced_at": {
      "format": "date-time",
      "title": "Last Advanced At",
      "type": "string"
    },
    "last_user_activity": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last User Activity"
    },
    "last_contact_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Contact At"
    },
    "contact_day": {
      "default": "",
      "title": "Contact Day",
      "type": "string"
    },
    "contacts_today": {
      "default": 0,
      "minimum": 0,
