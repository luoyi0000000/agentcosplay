{
  "$defs": {
    "MemoryScope": {
      "additionalProperties": false,
      "description": "Explicit memory audience, independent of confidence and retrieval scores.\n\n显式记忆受众；置信度、召回分数和同群关系均不授予访问权。",
      "properties": {
        "kind": {
          "enum": [
            "PARTICIPANT_CHARACTER",
            "ENDPOINT_CHARACTER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "participant_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participant Id"
        },
        "endpoint_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "MemoryScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Store a scoped canonical summary with provenance and validity, never an exact quote.\n\n保存带作用域、来源及有效性的规范摘要，不冒充原话。",
  "properties": {
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "owner": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "character_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Character Id",
      "type": "string"
    },
    "record_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "session",
            "short_term",
            "character_long_term",
            "relationship",
            "real_user"
          ],
          "type": "string"
        },
        {
          "const": "shared_roleplay",
          "type": "string"
        }
      ],
      "default": "character_long_term",
      "title": "Kind"
    },
    "session_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "turn_id": {
      "anyOf": [
        {
          "maxLength": 305,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    },
    "content": {
      "maxLength": 4000,
      "title": "Content",
      "type": "string"
    },
    "semantic_key": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Key"
    },
    "durability": {
      "default": "persistent",
      "enum": [
        "temporary",
        "persistent",
        "explicit"
      ],
      "title": "Durability",
      "type": "string"
    },
    "activation": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Activation",
      "type": "number"
    },
    "reinforcement": {
      "default": 0,
      "minimum": 0,
      "title": "Reinforcement",
      "type": "integer"
    },
    "last_injected_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Injected At"
    },
    "useful_count": {
      "default": 0,
      "minimum": 0,
      "title": "Useful Count",
      "type": "integer"
    },
    "event_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event At"
    },
    "superseded_by": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By"
    },
    "importance": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Importance",
      "type": "number"
    },
    "confidence": {
      "default": 0.8,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "source": {
      "default": "conversation",
      "maxLength": 2000,
      "title": "Source",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Evidence Refs",
      "type": "array"
    },
    "authority": {
      "default": "INFERRED",
      "enum": [
        "USER_EXPLICIT",
        "USER_MANUAL",
        "ADMIN_CONFIG",
        "TOOL_VERIFIED",
        "HOST_OBSERVED",
        "MODEL_DERIVED",
        "INFERRED",
        "SIMULATED"
      ],
      "title": "Authority",
      "type": "string"
    },
    "sensitivity": {
      "default": "private",
      "enum": [
        "public",
        "private",
        "sensitive"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "legacy_unverified": {
      "default": false,
      "title": "Legacy Unverified",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "last_access": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Access"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "archived",
        "expired",
        "forgotten"
      ],
      "title": "Status",
      "type": "string"
    },
    "occurrences": {
      "default": 1,
      "minimum": 1,
      "title": "Occurrences",
      "type": "integer"
    },
    "last_observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Observed At"
    },
    "observation_turn_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Observation Turn Ids",
      "type": "array"
    },
    "consolidated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consolidated At"
    },
    "promoted_from": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Promoted From"
    },
    "confirmation": {
      "default": "",
      "maxLength": 2000,
      "title": "Confirmation",
      "type": "string"
    }
  },
  "required": [
    "owner",
    "character_id",
    "content"
  ],
  "title": "Memory",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
