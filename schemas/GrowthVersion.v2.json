{
  "$defs": {
    "GrowthChange": {
      "additionalProperties": false,
      "description": "Describe one proposed stable overlay change in an allowed character domain.\n\n描述允许角色领域中的一项稳定叠加层变化提案。",
      "properties": {
        "domain": {
          "enum": [
            "personality",
            "world",
            "voice"
          ],
          "title": "Domain",
          "type": "string"
        },
        "key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "key",
        "value"
      ],
      "title": "GrowthChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Persist an approved overlay with predecessor, evidence and rollback provenance.\n\n保存已批准叠加层及前序版本、证据和回滚来源。",
  "properties": {
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "character_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Character Id",
      "type": "string"
    },
    "previous_version": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Version"
    },
    "overlay": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Overlay",
      "type": "object"
    },
    "diff": {
      "items": {
        "$ref": "#/$defs/GrowthChange"
      },
      "title": "Diff",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "impact": {
      "default": "high",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Impact",
      "type": "string"
    },
    "reason": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "approved_by": {
      "enum": [
        "USER_EXPLICIT",
        "EVIDENCE_GATE"
      ],
      "title": "Approved By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "character_id",
    "reason",
    "approved_by"
  ],
  "title": "GrowthVersion",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
