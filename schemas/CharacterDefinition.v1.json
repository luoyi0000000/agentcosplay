{
  "$defs": {
    "CatchphraseRule": {
      "additionalProperties": false,
      "description": "Optional suitability and repetition limits, never mandatory text insertion.\n\n可选适用场景与重复限制，绝不代表必须插入某个口头禅。",
      "properties": {
        "phrase": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Phrase",
          "type": "string"
        },
        "usage": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "title": "Usage",
          "type": "array"
        },
        "intensity": {
          "default": "light",
          "enum": [
            "light",
            "normal",
            "emphatic"
          ],
          "title": "Intensity",
          "type": "string"
        },
        "cooldown_seconds": {
          "default": 120,
          "maximum": 86400,
          "minimum": 0,
          "title": "Cooldown Seconds",
          "type": "integer"
        },
        "avoid_contexts": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Avoid Contexts",
          "type": "array"
        }
      },
      "required": [
        "phrase"
      ],
      "title": "CatchphraseRule",
      "type": "object"
    },
    "DialogueExample": {
      "additionalProperties": false,
      "description": "A curated meaning-to-expression example; assistant history is never baseline authority.\n\n精选的语义到人物表达示范；助手历史输出绝不自动成为基线权威。",
      "properties": {
        "meaning": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "character": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Character",
          "type": "string"
        }
      },
      "required": [
        "meaning",
        "character"
      ],
      "title": "DialogueExample",
      "type": "object"
    },
    "EmbodimentProfile": {
      "additionalProperties": false,
      "description": "Opt into simulated bodily axes; human physiology is never assumed by default.\n\n显式开启模拟身体维度，不默认假定人类生理需求。",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "sleep_enabled": {
          "default": false,
          "title": "Sleep Enabled",
          "type": "boolean"
        },
        "hunger_enabled": {
          "default": false,
          "title": "Hunger Enabled",
          "type": "boolean"
        },
        "physical_discomfort_enabled": {
          "default": false,
          "title": "Physical Discomfort Enabled",
          "type": "boolean"
        },
        "weather_sensitivity": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Weather Sensitivity",
          "type": "number"
        },
        "social_capacity_enabled": {
          "default": false,
          "title": "Social Capacity Enabled",
          "type": "boolean"
        },
        "custom_axes": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxProperties": 10,
          "propertyNames": {
            "maxLength": 200,
            "minLength": 1
          },
          "title": "Custom Axes",
          "type": "object"
        }
      },
      "title": "EmbodimentProfile",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "description": "Describe a sourced character-definition claim, separate from runtime FactRecord.\n\n描述有来源的角色定义声明，与 Runtime FactRecord 分离。",
      "properties": {
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "source_type": {
          "default": "inferred",
          "enum": [
            "user_explicit",
            "user_material",
            "official",
            "wiki",
            "model",
            "inferred"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "reference": {
          "default": "",
          "maxLength": 2000,
          "title": "Reference",
          "type": "string"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "canon_status": {
          "default": "inferred",
          "enum": [
            "canon",
            "user_defined",
            "unverified",
            "inferred"
          ],
          "title": "Canon Status",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Fact",
      "type": "object"
    },
    "GrowthPolicy": {
      "additionalProperties": false,
      "description": "Bound permitted changes by character domain rather than grant write authority.\n\n按角色领域限制允许变化，不授予写权限。",
      "properties": {
        "personality_mutability": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Personality Mutability",
          "type": "string"
        },
        "relationship_mutability": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Relationship Mutability",
          "type": "string"
        },
        "world_state_mutability": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "World State Mutability",
          "type": "string"
        }
      },
      "title": "GrowthPolicy",
      "type": "object"
    },
    "VoiceProfile": {
      "additionalProperties": false,
      "description": "One portable voice model for conversation and professional tasks alike.\n\n闲聊与专业任务共用同一可迁移表达模型，不建立第二套任务人格。",
      "properties": {
        "preferred_vocabulary": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Preferred Vocabulary",
          "type": "array"
        },
        "avoided_vocabulary": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Avoided Vocabulary",
          "type": "array"
        },
        "sentence_rhythm": {
          "default": "natural varied rhythm",
          "maxLength": 300,
          "title": "Sentence Rhythm",
          "type": "string"
        },
        "explanation_style": {
          "default": "character-appropriate, clear causal reasoning",
          "maxLength": 300,
          "title": "Explanation Style",
          "type": "string"
        },
        "analogy_style": {
          "default": "only when useful",
          "maxLength": 300,
          "title": "Analogy Style",
          "type": "string"
        },
        "evaluation_style": {
          "default": "direct with factual conditions intact",
          "maxLength": 300,
          "title": "Evaluation Style",
          "type": "string"
        },
        "disagreement_style": {
          "default": "state the reason respectfully",
          "maxLength": 300,
          "title": "Disagreement Style",
          "type": "string"
        },
        "question_style": {
          "default": "ask only useful follow-up questions",
          "maxLength": 300,
          "title": "Question Style",
          "type": "string"
        },
        "verbosity_default": {
          "default": "balanced",
          "enum": [
            "brief",
            "balanced",
            "detailed"
          ],
          "title": "Verbosity Default",
          "type": "string"
        },
        "sentence_length": {
          "default": "varied",
          "enum": [
            "short",
            "varied",
            "long"
          ],
          "title": "Sentence Length",
          "type": "string"
        },
        "directness": {
          "default": "direct",
          "enum": [
            "gentle",
            "direct",
            "blunt"
          ],
          "title": "Directness",
          "type": "string"
        },
        "addressing_style": {
          "default": "natural",
          "maxLength": 300,
          "title": "Addressing Style",
          "type": "string"
        },
        "self_reference_style": {
          "default": "natural",
          "maxLength": 300,
          "title": "Self Reference Style",
          "type": "string"
        },
        "humor_style": {
          "default": "character-appropriate",
          "maxLength": 300,
          "title": "Humor Style",
          "type": "string"
        },
        "emotional_expressiveness": {
          "default": "balanced",
          "enum": [
            "reserved",
            "balanced",
            "expressive"
          ],
          "title": "Emotional Expressiveness",
          "type": "string"
        },
        "catchphrase_rules": {
          "items": {
            "$ref": "#/$defs/CatchphraseRule"
          },
          "maxItems": 8,
          "title": "Catchphrase Rules",
          "type": "array"
        },
        "catchphrases": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Catchphrases",
          "type": "array"
        },
        "stage_direction_policy": {
          "default": "occasional",
          "enum": [
            "none",
            "occasional",
            "expressive"
          ],
          "title": "Stage Direction Policy",
          "type": "string"
        },
        "repetition_tolerance": {
          "default": "low",
          "enum": [
            "low",
            "normal"
          ],
          "title": "Repetition Tolerance",
          "type": "string"
        },
        "preferred_patterns": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Preferred Patterns",
          "type": "array"
        },
        "avoided_patterns": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Avoided Patterns",
          "type": "array"
        },
        "dialogue_examples": {
          "items": {
            "anyOf": [
              {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              {
                "$ref": "#/$defs/DialogueExample"
              }
            ]
          },
          "maxItems": 10,
          "title": "Dialogue Examples",
          "type": "array"
        }
      },
      "title": "VoiceProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Portable stable profile with explicit source facts and revision, not live session state.\n\n包含显式来源事实及版本的稳定可迁移档案，不存放实时会话状态。",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "origin": {
      "default": "original",
      "enum": [
        "original",
        "ip"
      ],
      "title": "Origin",
      "type": "string"
    },
    "mode": {
      "default": "au",
      "enum": [
        "canon",
        "au",
        "inspired"
      ],
      "title": "Mode",
      "type": "string"
    },
    "facts": {
      "additionalProperties": {
        "$ref": "#/$defs/Fact"
      },
      "maxProperties": 100,
      "propertyNames": {
        "maxLength": 200,
        "minLength": 1
      },
      "title": "Facts",
      "type": "object"
    },
    "default_task_mode": {
      "default": "soft_roleplay",
      "enum": [
        "full_roleplay",
        "soft_roleplay",
        "task_neutral"
      ],
      "title": "Default Task Mode",
      "type": "string"
    },
    "growth": {
      "$ref": "#/$defs/GrowthPolicy"
    },
    "voice": {
      "$ref": "#/$defs/VoiceProfile"
    },
    "embodiment": {
      "$ref": "#/$defs/EmbodimentProfile"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "name"
  ],
  "title": "CharacterDefinition",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
