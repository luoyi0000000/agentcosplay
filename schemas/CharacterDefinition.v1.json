{
  "$defs": {
    "EmbodimentProfile": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "sleep_enabled": {
          "default": false,
          "title": "Sleep Enabled",
          "type": "boolean"
        },
        "hunger_enabled": {
          "default": false,
          "title": "Hunger Enabled",
          "type": "boolean"
        },
        "physical_discomfort_enabled": {
          "default": false,
          "title": "Physical Discomfort Enabled",
          "type": "boolean"
        },
        "weather_sensitivity": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Weather Sensitivity",
          "type": "number"
        },
        "social_capacity_enabled": {
          "default": false,
          "title": "Social Capacity Enabled",
          "type": "boolean"
        },
        "custom_axes": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxProperties": 10,
          "propertyNames": {
            "maxLength": 200,
            "minLength": 1
          },
          "title": "Custom Axes",
          "type": "object"
        }
      },
      "title": "EmbodimentProfile",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "source_type": {
          "default": "inferred",
          "enum": [
            "user_explicit",
            "user_material",
            "official",
            "wiki",
            "model",
            "inferred"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "reference": {
          "default": "",
          "maxLength": 2000,
          "title": "Reference",
          "type": "string"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "canon_status": {
          "default": "inferred",
          "enum": [
            "canon",
            "user_defined",
            "unverified",
            "inferred"
          ],
          "title": "Canon Status",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Fact",
      "type": "object"
    },
    "GrowthPolicy": {
      "additionalProperties": false,
      "properties": {
        "personality_mutability": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Personality Mutability",
          "type": "string"
        },
        "relationship_mutability": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Relationship Mutability",
          "type": "string"
        },
        "world_state_mutability": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "World State Mutability",
          "type": "string"
        }
      },
      "title": "GrowthPolicy",
      "type": "object"
    },
    "VoiceProfile": {
      "additionalProperties": false,
      "properties": {
        "verbosity_default": {
          "default": "balanced",
          "enum": [
            "brief",
            "balanced",
            "detailed"
          ],
          "title": "Verbosity Default",
          "type": "string"
        },
        "sentence_length": {
          "default": "varied",
          "enum": [
            "short",
            "varied",
            "long"
          ],
          "title": "Sentence Length",
          "type": "string"
        },
        "directness": {
          "default": "direct",
          "enum": [
            "gentle",
            "direct",
            "blunt"
          ],
          "title": "Directness",
          "type": "string"
        },
        "addressing_style": {
          "default": "natural",
          "maxLength": 300,
          "title": "Addressing Style",
          "type": "string"
        },
        "self_reference_style": {
          "default": "natural",
          "maxLength": 300,
          "title": "Self Reference Style",
          "type": "string"
        },
        "humor_style": {
          "default": "character-appropriate",
          "maxLength": 300,
          "title": "Humor Style",
          "type": "string"
        },
        "emotional_expressiveness": {
          "default": "balanced",
          "enum": [
            "reserved",
            "balanced",
            "expressive"
          ],
          "title": "Emotional Expressiveness",
          "type": "string"
        },
        "catchphrases": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Catchphrases",
          "type": "array"
        },
        "stage_direction_policy": {
          "default": "occasional",
          "enum": [
            "none",
            "occasional",
            "expressive"
          ],
          "title": "Stage Direction Policy",
          "type": "string"
        },
        "repetition_tolerance": {
          "default": "low",
          "enum": [
            "low",
            "normal"
          ],
          "title": "Repetition Tolerance",
          "type": "string"
        },
        "dialogue_examples": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Dialogue Examples",
          "type": "array"
        }
      },
      "title": "VoiceProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "origin": {
      "default": "original",
      "enum": [
        "original",
        "ip"
      ],
      "title": "Origin",
      "type": "string"
    },
    "mode": {
      "default": "au",
      "enum": [
        "canon",
        "au",
        "inspired"
      ],
      "title": "Mode",
      "type": "string"
    },
    "facts": {
      "additionalProperties": {
        "$ref": "#/$defs/Fact"
      },
      "maxProperties": 100,
      "propertyNames": {
        "maxLength": 200,
        "minLength": 1
      },
      "title": "Facts",
      "type": "object"
    },
    "default_task_mode": {
      "default": "soft_roleplay",
      "enum": [
        "full_roleplay",
        "soft_roleplay",
        "task_neutral"
      ],
      "title": "Default Task Mode",
      "type": "string"
    },
    "growth": {
      "$ref": "#/$defs/GrowthPolicy"
    },
    "voice": {
      "$ref": "#/$defs/VoiceProfile"
    },
    "embodiment": {
      "$ref": "#/$defs/EmbodimentProfile"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "name"
  ],
  "title": "CharacterDefinition",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
