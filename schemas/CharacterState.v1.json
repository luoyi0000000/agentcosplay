{
  "$defs": {
    "Evolution": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "enum": [
            "personality",
            "world"
          ],
          "title": "Axis",
          "type": "string"
        },
        "key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "portable_summary": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Portable Summary"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Evidence Ids",
          "type": "array"
        },
        "at_turn": {
          "minimum": 1,
          "title": "At Turn",
          "type": "integer"
        }
      },
      "required": [
        "axis",
        "key",
        "value",
        "at_turn"
      ],
      "title": "Evolution",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "default": "stranger",
          "enum": [
            "stranger",
            "acquaintance",
            "familiar",
            "close"
          ],
          "title": "Stage",
          "type": "string"
        },
        "trust": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Trust",
          "type": "string"
        },
        "familiarity": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Familiarity",
          "type": "string"
        },
        "preferred_address": {
          "default": "",
          "maxLength": 100,
          "title": "Preferred Address",
          "type": "string"
        },
        "interaction_style": {
          "default": "",
          "maxLength": 500,
          "title": "Interaction Style",
          "type": "string"
        },
        "boundaries": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Boundaries",
          "type": "array"
        }
      },
      "title": "Relationship",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "character_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Character Id",
      "type": "string"
    },
    "relationship": {
      "$ref": "#/$defs/Relationship"
    },
    "evolution": {
      "items": {
        "$ref": "#/$defs/Evolution"
      },
      "maxItems": 100,
      "title": "Evolution",
      "type": "array"
    },
    "relationship_history": {
      "items": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        },
        "type": "object"
      },
      "maxItems": 100,
      "title": "Relationship History",
      "type": "array"
    },
    "known_characters": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Known Characters",
      "type": "array"
    },
    "shared_world_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shared World Id"
    },
    "turn_count": {
      "default": 0,
      "minimum": 0,
      "title": "Turn Count",
      "type": "integer"
    },
    "last_growth_turn": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Last Growth Turn",
      "type": "object"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "character_id"
  ],
  "title": "CharacterState",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
