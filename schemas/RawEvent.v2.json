      "title": "Host",
      "type": "string"
    },
    "platform": {
      "default": "",
      "maxLength": 100,
      "title": "Platform",
      "type": "string"
    },
    "conversation_id": {
      "default": "",
      "maxLength": 200,
      "title": "Conversation Id",
      "type": "string"
    },
    "actor_id": {
      "default": "",
      "maxLength": 200,
      "title": "Actor Id",
      "type": "string"
    },
    "source_ref": {
      "default": "",
      "maxLength": 1000,
      "title": "Source Ref",
      "type": "string"
