{
  "$defs": {
    "CatchphraseRule": {
      "additionalProperties": false,
      "description": "Optional suitability and repetition limits, never mandatory text insertion.\n\n可选适用场景与重复限制，绝不代表必须插入某个口头禅。",
      "properties": {
        "phrase": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Phrase",
          "type": "string"
        },
        "usage": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "title": "Usage",
          "type": "array"
        },
        "intensity": {
          "default": "light",
          "enum": [
            "light",
            "normal",
            "emphatic"
          ],
          "title": "Intensity",
          "type": "string"
        },
        "cooldown_seconds": {
          "default": 120,
          "maximum": 86400,
          "minimum": 0,
          "title": "Cooldown Seconds",
          "type": "integer"
        },
        "avoid_contexts": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Avoid Contexts",
          "type": "array"
        }
      },
      "required": [
        "phrase"
      ],
      "title": "CatchphraseRule",
      "type": "object"
    },
    "CharacterDefinition": {
      "additionalProperties": false,
      "description": "Portable stable profile with explicit source facts and revision, not live session state.\n\n包含显式来源事实及版本的稳定可迁移档案，不存放实时会话状态。",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "default": "original",
          "enum": [
            "original",
            "ip"
          ],
          "title": "Origin",
          "type": "string"
        },
        "mode": {
          "default": "au",
          "enum": [
            "canon",
            "au",
            "inspired"
          ],
          "title": "Mode",
          "type": "string"
        },
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          },
          "maxProperties": 100,
          "propertyNames": {
            "maxLength": 200,
            "minLength": 1
          },
          "title": "Facts",
          "type": "object"
        },
        "default_task_mode": {
          "default": "soft_roleplay",
          "enum": [
            "full_roleplay",
            "soft_roleplay",
            "task_neutral"
          ],
          "title": "Default Task Mode",
          "type": "string"
        },
        "growth": {
          "$ref": "#/$defs/GrowthPolicy"
        },
        "voice": {
          "$ref": "#/$defs/VoiceProfile"
        },
        "embodiment": {
          "$ref": "#/$defs/EmbodimentProfile"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "CharacterDefinition",
      "type": "object"
    },
    "CharacterState": {
      "additionalProperties": false,
      "description": "Retain baseline compatibility state; domain engines own their canonical projections.\n\n保留基线兼容状态；各领域引擎管理对应规范投影。",
      "properties": {
        "character_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Character Id",
          "type": "string"
        },
        "relationship": {
          "$ref": "#/$defs/Relationship"
        },
        "evolution": {
          "items": {
            "$ref": "#/$defs/Evolution"
          },
          "maxItems": 100,
          "title": "Evolution",
          "type": "array"
        },
        "relationship_history": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "object"
          },
          "maxItems": 100,
          "title": "Relationship History",
          "type": "array"
        },
        "turn_count": {
          "default": 0,
          "minimum": 0,
          "title": "Turn Count",
          "type": "integer"
        },
        "last_growth_turn": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Last Growth Turn",
          "type": "object"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "character_id"
      ],
      "title": "CharacterState",
      "type": "object"
    },
    "DialogueExample": {
      "additionalProperties": false,
      "description": "A curated meaning-to-expression example; assistant history is never baseline authority.\n\n精选的语义到人物表达示范；助手历史输出绝不自动成为基线权威。",
      "properties": {
        "meaning": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "character": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Character",
          "type": "string"
        }
      },
      "required": [
        "meaning",
        "character"
      ],
      "title": "DialogueExample",
      "type": "object"
    },
    "EmbodimentProfile": {
      "additionalProperties": false,
      "description": "Opt into simulated bodily axes; human physiology is never assumed by default.\n\n显式开启模拟身体维度，不默认假定人类生理需求。",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "sleep_enabled": {
          "default": false,
          "title": "Sleep Enabled",
          "type": "boolean"
        },
        "hunger_enabled": {
          "default": false,
          "title": "Hunger Enabled",
          "type": "boolean"
        },
        "physical_discomfort_enabled": {
          "default": false,
          "title": "Physical Discomfort Enabled",
          "type": "boolean"
        },
        "weather_sensitivity": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Weather Sensitivity",
          "type": "number"
        },
        "social_capacity_enabled": {
          "default": false,
          "title": "Social Capacity Enabled",
          "type": "boolean"
        },
        "custom_axes": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxProperties": 10,
          "propertyNames": {
            "maxLength": 200,
            "minLength": 1
          },
          "title": "Custom Axes",
          "type": "object"
        }
      },
      "title": "EmbodimentProfile",
      "type": "object"
    },
    "Evolution": {
      "additionalProperties": false,
      "description": "Preserve legacy evolution evidence references separately from approved Growth versions.\n\n保存旧演化的证据引用，与已批准的 Growth 版本分离。",
      "properties": {
        "axis": {
          "enum": [
            "personality",
            "world"
          ],
          "title": "Axis",
          "type": "string"
        },
        "key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "portable_summary": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Portable Summary"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Evidence Ids",
          "type": "array"
        },
        "at_turn": {
          "minimum": 1,
          "title": "At Turn",
          "type": "integer"
        }
      },
      "required": [
        "axis",
        "key",
        "value",
        "at_turn"
      ],
      "title": "Evolution",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "description": "Describe a sourced character-definition claim, separate from runtime FactRecord.\n\n描述有来源的角色定义声明，与 Runtime FactRecord 分离。",
      "properties": {
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "source_type": {
          "default": "inferred",
          "enum": [
            "user_explicit",
            "user_material",
            "official",
            "wiki",
            "model",
            "inferred"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "reference": {
          "default": "",
          "maxLength": 2000,
          "title": "Reference",
          "type": "string"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "canon_status": {
          "default": "inferred",
          "enum": [
            "canon",
            "user_defined",
            "unverified",
            "inferred"
          ],
          "title": "Canon Status",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Fact",
      "type": "object"
    },
    "GrowthPolicy": {
      "additionalProperties": false,
      "description": "Bound permitted changes by character domain rather than grant write authority.\n\n按角色领域限制允许变化，不授予写权限。",
      "properties": {
        "personality_mutability": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Personality Mutability",
          "type": "string"
        },
        "relationship_mutability": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Relationship Mutability",
          "type": "string"
        },
        "world_state_mutability": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "World State Mutability",
          "type": "string"
        }
      },
      "title": "GrowthPolicy",
      "type": "object"
    },
    "Memory": {
      "additionalProperties": false,
      "description": "Store a scoped canonical summary with provenance and validity, never an exact quote.\n\n保存带作用域、来源及有效性的规范摘要，不冒充原话。",
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "owner": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "character_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Character Id",
          "type": "string"
        },
        "record_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "session",
                "short_term",
                "character_long_term",
                "relationship",
                "real_user"
              ],
              "type": "string"
            },
            {
              "const": "shared_roleplay",
              "type": "string"
            }
          ],
          "default": "character_long_term",
          "title": "Kind"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "turn_id": {
          "anyOf": [
            {
              "maxLength": 305,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Id"
        },
        "content": {
          "maxLength": 4000,
          "title": "Content",
          "type": "string"
        },
        "semantic_key": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Key"
        },
        "durability": {
          "default": "persistent",
          "enum": [
            "temporary",
            "persistent",
            "explicit"
          ],
          "title": "Durability",
          "type": "string"
        },
        "activation": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Activation",
          "type": "number"
        },
        "reinforcement": {
          "default": 0,
          "minimum": 0,
          "title": "Reinforcement",
          "type": "integer"
        },
        "last_injected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Injected At"
        },
        "useful_count": {
          "default": 0,
          "minimum": 0,
          "title": "Useful Count",
          "type": "integer"
        },
        "event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event At"
        },
        "superseded_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "importance": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Importance",
          "type": "number"
        },
        "confidence": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "default": "conversation",
          "maxLength": 2000,
          "title": "Source",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Refs",
          "type": "array"
        },
        "authority": {
          "default": "INFERRED",
          "enum": [
            "USER_EXPLICIT",
            "USER_MANUAL",
            "ADMIN_CONFIG",
            "TOOL_VERIFIED",
            "HOST_OBSERVED",
            "MODEL_DERIVED",
            "INFERRED",
            "SIMULATED"
          ],
          "title": "Authority",
          "type": "string"
        },
        "sensitivity": {
          "default": "private",
          "enum": [
            "public",
            "private",
            "sensitive"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "legacy_unverified": {
          "default": false,
          "title": "Legacy Unverified",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "last_access": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Access"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "archived",
            "expired",
            "forgotten"
          ],
          "title": "Status",
          "type": "string"
        },
        "occurrences": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrences",
          "type": "integer"
        },
        "last_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Observed At"
        },
        "observation_turn_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Observation Turn Ids",
          "type": "array"
        },
        "consolidated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consolidated At"
        },
        "promoted_from": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promoted From"
        },
        "confirmation": {
          "default": "",
          "maxLength": 2000,
          "title": "Confirmation",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "character_id",
        "content"
      ],
      "title": "Memory",
      "type": "object"
    },
    "MemoryScope": {
      "additionalProperties": false,
      "description": "Explicit memory audience, independent of confidence and retrieval scores.\n\n显式记忆受众；置信度、召回分数和同群关系均不授予访问权。",
      "properties": {
        "kind": {
          "enum": [
            "PARTICIPANT_CHARACTER",
            "ENDPOINT_CHARACTER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "participant_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participant Id"
        },
        "endpoint_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "MemoryScope",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "description": "Bound relationship dimensions and explicit interaction boundaries.\n\n约束关系维度及显式互动边界。",
      "properties": {
        "stage": {
          "default": "stranger",
          "enum": [
            "stranger",
            "acquaintance",
            "familiar",
            "close"
          ],
          "title": "Stage",
          "type": "string"
        },
        "trust": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Trust",
          "type": "string"
        },
        "familiarity": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Familiarity",
          "type": "string"
        },
        "preferred_address": {
          "default": "",
          "maxLength": 100,
          "title": "Preferred Address",
          "type": "string"
        },
        "interaction_style": {
          "default": "",
          "maxLength": 500,
          "title": "Interaction Style",
          "type": "string"
        },
        "boundaries": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Boundaries",
          "type": "array"
        }
      },
      "title": "Relationship",
      "type": "object"
    },
    "VoiceProfile": {
      "additionalProperties": false,
      "description": "One portable voice model for conversation and professional tasks alike.\n\n闲聊与专业任务共用同一可迁移表达模型，不建立第二套任务人格。",
      "properties": {
        "preferred_vocabulary": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Preferred Vocabulary",
          "type": "array"
        },
        "avoided_vocabulary": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Avoided Vocabulary",
          "type": "array"
        },
        "sentence_rhythm": {
          "default": "natural varied rhythm",
          "maxLength": 300,
          "title": "Sentence Rhythm",
          "type": "string"
        },
        "explanation_style": {
          "default": "character-appropriate, clear causal reasoning",
          "maxLength": 300,
          "title": "Explanation Style",
          "type": "string"
        },
        "analogy_style": {
          "default": "only when useful",
          "maxLength": 300,
          "title": "Analogy Style",
          "type": "string"
        },
        "evaluation_style": {
          "default": "direct with factual conditions intact",
          "maxLength": 300,
          "title": "Evaluation Style",
          "type": "string"
        },
        "disagreement_style": {
          "default": "state the reason respectfully",
          "maxLength": 300,
          "title": "Disagreement Style",
          "type": "string"
        },
        "question_style": {
          "default": "ask only useful follow-up questions",
          "maxLength": 300,
          "title": "Question Style",
          "type": "string"
        },
        "verbosity_default": {
          "default": "balanced",
          "enum": [
            "brief",
            "balanced",
            "detailed"
          ],
          "title": "Verbosity Default",
          "type": "string"
        },
        "sentence_length": {
          "default": "varied",
          "enum": [
            "short",
            "varied",
            "long"
          ],
          "title": "Sentence Length",
          "type": "string"
        },
        "directness": {
          "default": "direct",
          "enum": [
            "gentle",
            "direct",
            "blunt"
          ],
          "title": "Directness",
          "type": "string"
        },
        "addressing_style": {
          "default": "natural",
          "maxLength": 300,
          "title": "Addressing Style",
          "type": "string"
        },
        "self_reference_style": {
          "default": "natural",
          "maxLength": 300,
          "title": "Self Reference Style",
          "type": "string"
        },
        "humor_style": {
          "default": "character-appropriate",
          "maxLength": 300,
          "title": "Humor Style",
          "type": "string"
        },
        "emotional_expressiveness": {
          "default": "balanced",
          "enum": [
            "reserved",
            "balanced",
            "expressive"
