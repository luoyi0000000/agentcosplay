{
  "$defs": {
    "GrowthChange": {
      "additionalProperties": false,
      "description": "Describe one proposed stable overlay change in an allowed character domain.\n\n描述允许角色领域中的一项稳定叠加层变化提案。",
      "properties": {
        "domain": {
          "enum": [
            "personality",
            "world",
            "voice"
          ],
          "title": "Domain",
          "type": "string"
        },
        "key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "key",
        "value"
      ],
      "title": "GrowthChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Track approval state without altering the character baseline.\n\n记录批准状态，不改变角色基线。",
  "properties": {
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "character_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Character Id",
      "type": "string"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/GrowthChange"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Changes",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 3,
      "title": "Evidence Refs",
      "type": "array"
    },
    "reason": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "impact": {
      "default": "high",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Impact",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "character_id",
    "changes",
    "evidence_refs",
    "reason"
  ],
  "title": "GrowthCandidate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
