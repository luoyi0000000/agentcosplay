{
  "$defs": {
    "EventInput": {
      "additionalProperties": false,
      "properties": {
        "source_event_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Event Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "USER_DIRECT",
            "ASSISTANT_VISIBLE",
            "QUOTED",
            "FORWARDED",
            "MEDIA_DERIVED",
            "TOOL_RESULT",
            "WEB_CONTENT",
            "SIMULATED",
            "PLANNED"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "content": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "host": {
          "default": "",
          "maxLength": 100,
          "title": "Host",
          "type": "string"
        },
        "platform": {
          "default": "",
          "maxLength": 100,
          "title": "Platform",
          "type": "string"
        },
        "conversation_id": {
          "default": "",
          "maxLength": 200,
          "title": "Conversation Id",
          "type": "string"
        },
        "actor_id": {
          "default": "",
          "maxLength": 200,
          "title": "Actor Id",
          "type": "string"
        },
        "source_ref": {
          "default": "",
          "maxLength": 1000,
          "title": "Source Ref",
          "type": "string"
        },
        "sensitivity": {
          "default": "private",
          "enum": [
            "public",
            "private",
            "sensitive"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "source_event_id",
        "source_id",
        "source_kind",
        "content",
        "timestamp"
      ],
      "title": "EventInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EventInput"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "mode": {
      "default": "realtime",
      "enum": [
        "realtime",
        "backfill",
        "import"
      ],
      "title": "Mode",
      "type": "string"
    },
    "sensitive_confirmation": {
      "default": "",
      "maxLength": 1000,
      "title": "Sensitive Confirmation",
      "type": "string"
    },
    "checkpoint_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Revision"
    }
  },
  "required": [
    "operation_id",
    "session_id",
    "events"
  ],
  "title": "EventBatch",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
